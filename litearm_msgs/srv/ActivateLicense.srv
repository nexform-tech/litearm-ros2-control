# Submit a vendor-signed activation credential (firmware CMD_ACTIVATE).
#
# The arm must be disabled first; the driver refuses otherwise rather than letting the
# firmware reject the frame.
#
# The MAC has to come from the vendor's signing tool. No key material lives in this
# repository or in the driver.

uint32 cust_id
uint32 issued          # YYYYMMDD
uint32 flags
uint8[16] mac          # two SipHash-2-4 tags produced by the vendor tool
---
bool success
string message

uint8 state            # licence state read back after the attempt
string state_name
