<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>litearm_ros2_control</name>
  <version>1.0.0</version>
  <description>
    ros2_control SystemInterface for the litearm arm, driving it directly over USB CDC
    through the litearm C++ SDK. read() consumes the SDK's cached 100 Hz status frame;
    write() streams joint position/velocity references to the firmware's MOVE_JS servo.
  </description>
  <maintainer email="wurihao@nexform.tech">thetooler</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- The litearm C++ SDK: a plain CMake package, not a rosdep key, so `rosdep install`
       cannot resolve it alone. CMakeLists prefers an installed litearm (find_package) and
       otherwise builds the litearm-cpp source tree beside this repository into this
       package, so a plain `colcon build` needs no manual install step. -->
  <depend>litearm</depend>

  <!-- The URDF description moved to its own repository (nexform-tech/litearm-description):
       urdf/litearm.urdf.xacro includes $(find litearm_description)/urdf/litearm_description.urdf,
       so that package has to be in the workspace (or installed) at launch time. It is not a
       rosdep key either. -->
  <exec_depend>litearm_description</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
